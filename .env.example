# Application Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL Connection URL or individual parameters)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ralahami_restaurant_db

# Alternative discrete PostgreSQL configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ralahami_restaurant_db

# JWT Security Secrets
JWT_SECRET=ralahami_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=1d

# Client CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Email Notification & SMTP Configuration (Nodemailer)
EMAIL_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_restaurant_email@gmail.com
SMTP_PASS=your_16_digit_app_password
SMTP_FROM="Raalahami Restaurant <your_restaurant_email@gmail.com>"
