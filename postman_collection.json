    {
      "name": "Authentication & RBAC",
      "item": [
        {
          "name": "Register Customer Account",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    var token = json.token || (json.data && json.data.token);",
                  "    if (token) {",
                  "        pm.collectionVariables.set('authToken', token);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"Nimal Fernando\",\n  \"email\": \"customer@ralahami.lk\",\n  \"password\": \"Password123!\",\n  \"phone\": \"+94771234567\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Registers a new customer and returns JWT access token."
          }
        },
